# Local development credentials and host ports used by Docker Compose.
POSTGRES_DB=linka
POSTGRES_USER=linka
POSTGRES_PASSWORD=linka-dev-password
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=8333

# Linka server settings loaded by dotenvy. URL-encode credentials in DATABASE_URL
# if you change them to values containing URL-reserved characters.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}"
POSTGRES_POOL_MIN_CONNECTIONS=1
POSTGRES_POOL_MAX_CONNECTIONS=10
POSTGRES_POOL_ACQUIRE_TIMEOUT_SECS=10
# Set either of these to 0 to disable that timeout.
POSTGRES_POOL_IDLE_TIMEOUT_SECS=600
POSTGRES_POOL_MAX_LIFETIME_SECS=1800
REDIS_URL="redis://127.0.0.1:${REDIS_PORT}/0"
REDIS_POOL_MAX_SIZE=8
REDIS_POOL_WAIT_TIMEOUT_SECS=3
REDIS_POOL_CREATE_TIMEOUT_SECS=10
REDIS_CONNECT_TIMEOUT_SECS=2
REDIS_RESPONSE_TIMEOUT_SECS=2
REDIS_CONNECT_RETRIES=3

# S3 settings shared by the server and the local SeaweedFS container.
AWS_ENDPOINT="http://127.0.0.1:${S3_PORT}"
AWS_ACCESS_KEY_ID=linka-dev
AWS_SECRET_ACCESS_KEY=linka-dev-secret
AWS_REGION=us-east-1
AWS_BUCKET=linka
AWS_ALLOW_HTTP=true
AWS_VIRTUAL_HOSTED_STYLE_REQUEST=false
S3_STARTUP_TIMEOUT_SECS=10
RUST_LOG=info
