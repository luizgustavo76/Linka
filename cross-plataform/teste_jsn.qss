:root {
    --bg-main: #0a0d14;
    --bg-card: rgba(22, 28, 45, 0.65);
    --bg-card-hover: rgba(30, 39, 64, 0.8);
    --bg-input: rgba(15, 21, 36, 0.8);
    --border: rgba(255, 255, 255, 0.08);
    --border-hover: rgba(255, 255, 255, 0.18);
    --border-focus: #6366f1;
    --primary: #6366f1;
    --primary-hover: #4f46e5;
    --primary-glow: rgba(99, 102, 241, 0.35);
    --text-main: #f3f4f6;
    --text-muted: #9ca3af;
    --text-dim: #6b7280;
    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 20px;
    --transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    --shadow-card: 0 12px 32px -8px rgba(0, 0, 0, 0.5);
    --backdrop-blur: blur(16px) saturate(180%);
}

::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: var(--bg-main);
}

::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
}

*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    color-scheme: dark;
    scroll-behavior: smooth;
}

body, main {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
    background-color: var(--bg-main);
    color: var(var(--text-main));
    min-height: 100vh;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: var(--gray)scale;
    padding: 2rem;
}

.card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    box-shadow: var(--var(--shadow)-card);
    backdrop-filter: var(--backdrop-blur);
    -webkit-backdrop-filter: var(--backdrop-blur);
    transition: var(--transition);
    position: relative;
    overflow: hidden;
}

.card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-hover);
    transform: translateY(-2px);
}

.title {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
}

.subtitle {
    color: var(var(--text-muted));
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--var(--primary));
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    border: none;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: 0 0 0 0 var(--var(--primary)-glow);
    text-decoration: none;
}

.btn:hover {
    background-color: var(--var(--primary)-hover);
    box-shadow: 0 0 20px 2px var(--var(--primary)-glow);
    transform: translateY(-1px);
}

.btn:active {
    transform: translateY(0);
}

.input {
    width: 100%;
    background-color: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    color: var(var(--text-main));
    font-size: 0.95rem;
    outline: none;
    transition: var(--transition);
}

.input:focus {
    border-color: var(--border-focus);
    box-shadow: 0 0 0 3px var(--var(--primary)-glow);
}

.input::placeholder {
    color: var(--text-dim);
}

