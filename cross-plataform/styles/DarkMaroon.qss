QWidget {
    background-color: #121212;
    color: #E6E6E6;
    font-family: "Segoe UI";
    font-size: 14px;
}

QLabel { color: #E6E6E6; }
QLabel#title { font-size: 22px; font-weight: 600; color: #FFFFFF; }

QFrame {
    background-color: #161616;
    border: 1px solid #242424;
    border-radius: 14px;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #181818;
    color: #FFFFFF;
    border: 1px solid #2A2A2A;
    border-radius: 10px;
    padding: 8px 10px;
}
QLineEdit:focus { border: 1px solid #ff4757; }

QPushButton {
    background-color: #1C1C1C;
    color: #EAEAEA;
    border: 1px solid #2A2A2A;
    border-radius: 12px;
    padding: 10px 14px;
    font-weight: 600;
    max-width: 300px;
}
QPushButton:hover { background-color: #222222; border: 1px solid #ff4757; }
QPushButton:pressed { background-color: #171717; border: 1px solid #d63031; }

QPushButton[class="tab-button"] {
    background-color: transparent; 
    border: none;                  
    color: #888888;                
    font-size: 16px;
    font-weight: bold;
    padding-bottom: 8px;           
    border-bottom: 2px solid transparent; 
}
QPushButton[class="tab-button"]:hover { color: #FFFFFF; }
QPushButton[class="tab-button"][active="true"] {
    color: #ff4757;
    border-bottom: 3px solid #ff4757;
    background-color: qlineargradient(x1:0, y1:1, x2:0, y2:0,
                                      stop:0 rgba(255, 71, 87, 0.25),
                                      stop:1 rgba(0, 0, 0, 0));
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #2A2A2A; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #ff4757; }