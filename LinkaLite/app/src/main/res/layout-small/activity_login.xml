<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#120E0A">

    <ImageView
        android:id="@+id/img_bg_polaroid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_login" />

    <!-- Botão Server bem compacto no canto -->
    <Button
        android:id="@+id/btnServer"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp"
        android:background="#4D000000"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:text="Server"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp" />

    <!-- Bloco de Título Compacto em 1 linha -->
    <LinearLayout
        android:id="@+id/box_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_stay_connected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="STAY"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/img_linked"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/linked" />
        </LinearLayout>

        <!-- Barra arco-íris minimalista -->
        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="2dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#D93829" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#E87A24" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#F2C12E" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#2B8A6E" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cartão de Login Compacto para deixar a câmera visível -->
    <LinearLayout
        android:id="@+id/card_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_login_card"
        android:orientation="vertical"
        android:padding="10dp">

        <EditText
            android:id="@+id/edtUsername"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@drawable/bg_input_field"
            android:hint="Username"
            android:inputType="textNoSuggestions"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#8A949E"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#8A949E"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_enter"
            android:text="Enter"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtGoToSignup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register!"
                android:textColor="#2B5B84"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:text="•"
                android:textColor="#9AA4AE"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtGuest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore as guest"
                android:textColor="#5C6670"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>