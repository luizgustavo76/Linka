<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E888888" />
            <stroke android:width="1dip" android:color="#55888888" />
            <corners android:radius="5dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1C888888"
                android:endColor="#0D888888"
                android:angle="270" />
            <stroke android:width="1dip" android:color="#40888888" />
            <corners android:radius="5dip" />
        </shape>
    </item>
</selector>