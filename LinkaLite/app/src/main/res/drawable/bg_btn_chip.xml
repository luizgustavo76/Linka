<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#26888888" />
            <stroke android:width="1dip" android:color="#55888888" />
            <corners android:radius="18dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12888888" />
            <stroke android:width="1dip" android:color="#33888888" />
            <corners android:radius="18dip" />
        </shape>
    </item>
</selector>