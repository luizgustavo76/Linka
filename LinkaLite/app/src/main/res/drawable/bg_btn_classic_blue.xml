<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado Pressionado: o botão "afunda" 1dip -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dip">
                <shape android:shape="rectangle">
                    <solid android:color="#1E4466" />
                    <stroke android:width="1dip" android:color="#132D45" />
                    <corners android:radius="5dip" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Estado Normal: Sombra embaixo + Degradê + Brilho no topo -->
    <item>
        <layer-list>
            <!-- 1. Sombra escura na base (2dip para baixo) -->
            <item android:top="2dip">
                <shape android:shape="rectangle">
                    <solid android:color="#12293D" />
                    <corners android:radius="5dip" />
                </shape>
            </item>

            <!-- 2. Corpo principal do botão (sobe 1dip para mostrar a sombra) -->
            <item android:bottom="1dip">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#4684BA"
                        android:endColor="#255178"
                        android:angle="270" />
                    <stroke android:width="1dip" android:color="#1A3B59" />
                    <corners android:radius="5dip" />
                </shape>
            </item>

            <!-- 3. Linha de brilho interno no topo (1dip de margem interna) -->
            <item
                android:top="1dip"
                android:left="1dip"
                android:right="1dip"
                android:bottom="2dip">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dip" android:color="#33FFFFFF" />
                    <corners android:radius="4dip" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>