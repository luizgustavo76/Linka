<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Camada 1: Cor sólida sem gradiente -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#39c6fe" />
        </shape>
    </item>

    <!-- Camada 2: Linha de brilho sutil no topo (1px) -->
    <item android:bottom="47dip">
        <shape android:shape="rectangle">
            <solid android:color="#b8ebff" />
        </shape>
    </item>

    <!-- Camada 3: Linha de divisória escura na base (1px) -->
    <item android:top="47dip">
        <shape android:shape="rectangle">
            <solid android:color="#03bcf9" />
        </shape>
    </item>
</layer-list>