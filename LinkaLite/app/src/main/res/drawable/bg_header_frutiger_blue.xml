<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Camada 1: O gradiente com contraste marcante -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#93d8f4"
                android:centerColor="#72d7ff"
                android:endColor="#39c6fe"
                android:type="linear" />
        </shape>
    </item>

    <!-- Camada 2: Linha de brilho sutil no topo (1px) -->
    <item android:bottom="47dip">
        <shape android:shape="rectangle">
            <solid android:color="#b8ebff" />
        </shape>
    </item>

    <!-- Camada 3: Linha de divisória escura na base (1px) -->
    <item android:top="47dip">
        <shape android:shape="rectangle">
            <solid android:color="#03bcf9" />
        </shape>
    </item>
</layer-list>