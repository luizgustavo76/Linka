<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Camada 1: O gradiente com contraste marcante -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#de6e6e"
                android:centerColor="#D44242"
                android:endColor="#B42D2D"
                android:type="linear" />
        </shape>
    </item>

    <!-- Camada 2: Linha de brilho sutil no topo (1px) -->
    <item android:bottom="47dip">
        <shape android:shape="rectangle">
            <solid android:color="#FC8383" />
        </shape>
    </item>

    <!-- Camada 3: Linha de divisória escura na base (1px) -->
    <item android:top="47dip">
        <shape android:shape="rectangle">
            <solid android:color="#9B3131" />
        </shape>
    </item>
</layer-list>