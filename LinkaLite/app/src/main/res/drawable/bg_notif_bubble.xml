<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Pontinha (triângulo) na base usando um quadrado rotacionado 45 graus -->
    <item
        android:width="12dip"
        android:height="12dip"
        android:gravity="bottom|center_horizontal"
        android:bottom="2dip">
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="#FF4B4B" />
                <corners android:radius="2dip" />
            </shape>
        </rotate>
    </item>

    <!-- 2. Corpo principal do balão -->
    <item android:bottom="6dip">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF5A52"
                android:endColor="#E63935"
                android:angle="270" />
            <corners android:radius="8dip" />
            <padding
                android:left="10dip"
                android:right="10dip"
                android:top="6dip"
                android:bottom="6dip" />
        </shape>
    </item>

</layer-list>