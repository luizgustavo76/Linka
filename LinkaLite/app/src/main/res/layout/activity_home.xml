<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="#E5E8EC">

        <!-- CONTEÚDO PRINCIPAL (TIMELINE / CHAT) -->
        <HorizontalScrollView
            android:id="@+id/scrollViewPages"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_above="@+id/bottomBarContainer"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/pageTimeline"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent">
                    <ListView
                        android:id="@+id/listViewTimeline"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:background="#E5E8EC"
                        android:cacheColorHint="#E5E8EC"
                        android:scrollingCache="true"
                        android:clipToPadding="false"
                        android:paddingTop="54dip"
                        android:paddingBottom="12dip"
                        android:divider="@null"
                        android:dividerHeight="0dip" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/pageChat"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:paddingTop="49dip">
                    <ListView
                        android:id="@+id/listViewChat"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:background="#E5E8EC"
                        android:cacheColorHint="#E5E8EC"
                        android:scrollingCache="false"
                        android:divider="@null"
                        android:dividerHeight="0dip" />
                </FrameLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- TOP BAR ÚNICA E RETRÁTIL (ESTILO IG 2013) -->
        <LinearLayout
            android:id="@+id/topHeaderContainer"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/topBarContainer"
                android:layout_width="fill_parent"
                android:layout_height="48dip"
                android:background="@drawable/bg_header_gradient"
                android:paddingLeft="8dip"
                android:paddingRight="8dip">

                <ImageButton
                    android:id="@+id/btnHamburger"
                    android:layout_width="32dip"
                    android:layout_height="32dip"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_drawer" />

                <Spinner
                    android:id="@+id/spinner_feeds"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_toRightOf="@+id/btnHamburger"
                    android:layout_toLeftOf="@+id/logo"
                    android:layout_marginLeft="6dip"
                    android:layout_marginRight="6dip"
                    android:background="@android:color/transparent"
                    android:spinnerMode="dropdown" />

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="30dip"
                    android:layout_height="30dip"
                    android:layout_centerInParent="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/linka_icon_bar" />

                <!-- BOTÃO DE CHAT / DIRECT NO CANTO SUPERIOR DIREITO -->
                <ImageButton
                    android:id="@+id/btnTopChat"
                    android:layout_width="40dip"
                    android:layout_height="40dip"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:padding="7dip"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_chats" />
            </RelativeLayout>

            <View
                android:layout_width="fill_parent"
                android:layout_height="1dip"
                android:background="#111111" />
        </LinearLayout>

        <!-- BARRA DE AVISO GUEST (ACIMA DA BOTTOM BAR) -->
        <LinearLayout 
            android:id="@+id/layoutGuest"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" 
            android:layout_above="@+id/bottomBarContainer"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#222222"
            android:padding="6dip"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGuest"
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="You are browsing as a guest. Log in for full options!"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:gravity="center_vertical" />

            <Button 
                android:id="@+id/btnLogin"
                android:layout_width="wrap_content"
                android:layout_height="32dip"
                android:paddingLeft="10dip"
                android:paddingRight="10dip"
                android:background="#29B6F6"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="Login"
                android:textSize="11sp"
                android:layout_marginLeft="4dip"
                android:layout_marginRight="4dip" />

            <Button 
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="32dip"
                android:paddingLeft="8dip"
                android:paddingRight="8dip"
                android:text="X"
                android:textSize="11sp"
                android:layout_marginLeft="2dip" />
        </LinearLayout>

        <!-- BOTTOM NAVIGATION BAR ESTILO INSTAGRAM 2013/2014 -->
        <LinearLayout
            android:id="@+id/bottomBarContainer"
            android:layout_width="fill_parent"
            android:layout_height="48dip"
            android:layout_alignParentBottom="true"
            android:background="#1E1E1E"
            android:orientation="vertical">

            <View
                android:layout_width="fill_parent"
                android:layout_height="1dip"
                android:background="#0F0F0F" />

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 1. FEED / HOME -->
                <ImageButton
                    android:id="@+id/navHome"
                    android:layout_width="0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1"
                    android:background="#2A2A2A"
                    android:padding="11dip"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_feed" />

                <!-- 2. COMMUNITIES -->
                <ImageButton
                    android:id="@+id/navCommunities"
                    android:layout_width="0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:padding="11dip"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_community" />

                <!-- 3. NOVO POST (BOTÃO CENTRAL AZUL CLÁSSICO DO IG) -->
                <ImageButton
                    android:id="@+id/fabNewPost"
                    android:layout_width="0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.15"
                    android:background="#1C5380"
                    android:padding="10dip"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_post" />

                <!-- 4. INBOX / NOTIFICAÇÕES -->
                <ImageButton
                    android:id="@+id/btnNotifications"
                    android:layout_width="0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:padding="11dip"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_inbox" />

                <!-- 5. PERFIL / ACCOUNT -->
                <ImageButton
                    android:id="@+id/btnProfile"
                    android:layout_width="0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:padding="11dip"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_profile" />

            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

    <include layout="@layout/drawer_home" />

</android.support.v4.widget.DrawerLayout>