<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:background="#121212" 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" 
        android:orientation="horizontal"
        android:background="#1e1e2e">

        <Button
            android:id="@+id/newerButton"
            android:layout_width="0dip"
            android:layout_height="32dip"
            android:layout_weight="1"
            android:padding="0dip"
            android:text="newer"
            android:textSize="11sp"
            android:layout_margin="2dip" />  

        <Button
            android:id="@+id/federationsButton"
            android:layout_width="0dip"
            android:layout_height="32dip"
            android:layout_weight="1"
            android:padding="0dip"
            android:text="federations"
            android:textSize="11sp"
            android:layout_margin="2dip" />  

    </LinearLayout>

    <Button 
        android:id="@+id/newPost"
        android:layout_width="fill_parent"
        android:layout_height="32dip"
        android:padding="0dip"
        android:text="+ New Post"
        android:textSize="11sp"
        android:layout_margin="2dip" />

    <!-- Lista principal de Posts -->
    <ListView
        android:id="@+id/listViewPosts"
        android:layout_width="fill_parent"
        android:layout_height="0dip"
        android:layout_weight="1"
        android:scrollingCache="false"   
        android:divider="#2a2a3c"
        android:dividerHeight="1dip" />
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No posts yet!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check out federations to explore Reddit, Mastodon, and Bluesky feeds."
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnEmptyFederations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visit Federations"
            android:layout_marginTop="16dp" />
    </LinearLayout>
    <LinearLayout 
        android:layout_width="fill_parent"
        android:layout_height="40dip" 
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#11111b">

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:src="@drawable/home"
            android:scaleType="centerInside"
            android:background="@android:color/transparent" />

        <ImageButton
            android:id="@+id/btnChat"
            android:layout_width="0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:src="@drawable/chat"
            android:scaleType="centerInside"
            android:background="@android:color/transparent" />

        <ImageButton
            android:id="@+id/btnOptions"
            android:layout_width="0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:src="@drawable/options"
            android:scaleType="centerInside"
            android:background="@android:color/transparent" />

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:src="@drawable/account"
            android:scaleType="centerInside"
            android:background="@android:color/transparent" />

    </LinearLayout>

</LinearLayout>