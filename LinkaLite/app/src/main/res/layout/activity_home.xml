<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="#ffffff">

        <!-- SCROLL VIEW EXPANDIDO PARA A TELA INTEIRA -->
        <HorizontalScrollView
            android:id="@+id/scrollViewPages"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/pageTimeline"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent">
                    <ListView
                        android:id="@+id/listViewTimeline"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:scrollingCache="true"
                        android:clipToPadding="false"
                        android:paddingTop="78dip"
                        android:divider="#E0E0E0"
                        android:dividerHeight="1dip" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/pageLocal"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent">
                    <ListView
                        android:id="@+id/listViewLocal"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:scrollingCache="true"
                        android:clipToPadding="false"
                        android:paddingTop="78dip"
                        android:divider="#E0E0E0"
                        android:dividerHeight="1dip" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/pageChat"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:paddingTop="78dip">
                    <ListView
                        android:id="@+id/listViewChat"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:scrollingCache="false"
                        android:divider="#E0E0E0"
                        android:dividerHeight="1dip" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/pageOptions"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:paddingTop="78dip">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Settings &amp; Options"
                        android:textColor="#666666" />
                </FrameLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- HEADER FLUTUANTE (FICA SOBREPOSTO AO FEED) -->
        <LinearLayout
            android:id="@+id/topHeaderContainer"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/topBarContainer"
                android:layout_width="fill_parent"
                android:layout_height="48dip"
                android:background="#121212"
                android:paddingLeft="6dip"
                android:paddingRight="6dip">

                <ImageButton
                    android:id="@+id/btnHamburger"
                    android:layout_width="40dip"
                    android:layout_height="40dip"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_sort_by_size" />

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="wrap_content"
                    android:layout_height="30dip"
                    android:layout_centerInParent="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/linka_icon_bar" />

                <LinearLayout
                    android:id="@+id/rightBarButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_alignParentRight="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnNotifications"
                        android:layout_width="42dip"
                        android:layout_height="42dip"
                        android:padding="6dip"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_inbox" />

                    <ImageButton
                        android:id="@+id/btnProfile"
                        android:layout_width="42dip"
                        android:layout_height="42dip"
                        android:layout_marginLeft="10dip"
                        android:padding="6dip"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_profile" />
                </LinearLayout>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/tabBarContainer"
                android:layout_width="fill_parent"
                android:layout_height="30dip"
                android:background="#222222">

                <TextView
                    android:id="@+id/tabPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_alignParentLeft="true"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dip"
                    android:paddingRight="12dip"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#888888"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/tabCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_centerInParent="true"
                    android:gravity="center_vertical"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:text="Timeline" />

                <TextView
                    android:id="@+id/tabNext"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:layout_alignParentRight="true"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dip"
                    android:paddingRight="12dip"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#888888"
                    android:text="Local Feed ▶" />
            </RelativeLayout>
        </LinearLayout>

        <!-- BARRA DE GUEST -->
        <LinearLayout 
            android:id="@+id/layoutGuest"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" 
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#333333"
            android:padding="4dip"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGuest"
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="You are browsing as a guest. Log in for full options!"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:gravity="center_vertical" />

            <Button 
                android:id="@+id/btnLogin"
                android:layout_width="wrap_content"
                android:layout_height="32dip"
                android:paddingLeft="8dip"
                android:paddingRight="8dip"
                android:text="Login"
                android:textSize="11sp"
                android:layout_marginLeft="4dip"
                android:layout_marginRight="2dip" />

            <Button 
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="32dip"
                android:paddingLeft="8dip"
                android:paddingRight="8dip"
                android:text="X"
                android:textSize="11sp"
                android:layout_marginLeft="2dip" />
        </LinearLayout>

        <!-- BOTÃO FLUTUANTE (FAB) -->
        <ImageButton
            android:id="@+id/fabNewPost"
            android:layout_width="56dip"
            android:layout_height="56dip"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginRight="16dip"
            android:layout_marginBottom="16dip"
            android:padding="14dip"
            android:background="@drawable/fab_blue_bg"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_post" />

    </RelativeLayout>

    <include layout="@layout/drawer_home" />

</android.support.v4.widget.DrawerLayout>