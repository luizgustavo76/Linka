<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#E5E8EC">

    <!-- TOP BAR NO MESMO PADRÃO DO HOME -->
    <RelativeLayout
        android:id="@+id/topBarCommunities"
        android:layout_width="fill_parent"
        android:layout_height="48dip"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_header_gradient"
        android:paddingLeft="8dip"
        android:paddingRight="8dip">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="34dip"
            android:layout_height="34dip"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_previous" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="28dip"
            android:layout_height="28dip"
            android:layout_centerVertical="true"
            android:layout_marginLeft="8dip"
            android:layout_toRightOf="@id/btnBack"
            android:scaleType="fitCenter"
            android:src="@drawable/linka_icon_bar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="8dip"
            android:layout_toRightOf="@id/logo"
            android:text="Communities"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_alignParentRight="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRefreshCommunities"
                android:layout_width="38dip"
                android:layout_height="38dip"
                android:background="@android:color/transparent"
                android:padding="6dip"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_popup_sync" />

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="38dip"
                android:layout_height="38dip"
                android:layout_marginLeft="6dip"
                android:background="@android:color/transparent"
                android:padding="6dip"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_profile" />
        </LinearLayout>
    </RelativeLayout>

    <!-- BARRA DE PESQUISA -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBarCommunities"
        android:background="#222222"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dip">

        <EditText
            android:id="@+id/editSearch"
            android:layout_width="0dip"
            android:layout_height="38dip"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:drawableLeft="@android:drawable/ic_menu_search"
            android:drawablePadding="8dip"
            android:hint="Search communities..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingLeft="10dip"
            android:paddingRight="10dip"
            android:singleLine="true"
            android:textColor="#111111"
            android:textColorHint="#777777"
            android:textSize="13sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/listViewCommunities"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/searchContainer"
        android:background="#E5E8EC"
        android:cacheColorHint="#E5E8EC"
        android:clipToPadding="false"
        android:divider="#D0D4D9"
        android:dividerHeight="1dip"
        android:fadingEdge="none"
        android:fastScrollEnabled="true"
        android:paddingBottom="76dip"
        android:smoothScrollbar="true" />

    <!-- BOTÃO FLUTUANTE PARA CRIAR COMUNIDADE -->
    <Button
        android:id="@+id/btnNew"
        android:layout_width="56dip"
        android:layout_height="56dip"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="16dip"
        android:layout_marginRight="16dip"
        android:background="@drawable/fab_blue_bg"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

</RelativeLayout>