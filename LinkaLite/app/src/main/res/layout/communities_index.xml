<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#d6d6d6"
    android:orientation="vertical">

    <!-- 1. TOP BAR -->
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="48dip"
        android:background="#1C1C1C"
        android:paddingLeft="8dip"
        android:paddingRight="8dip">

        <ImageButton
            android:id="@+id/btnHamburger"
            android:layout_width="40dip"
            android:layout_height="40dip"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_sort_by_size" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="4dip"
            android:layout_toRightOf="@id/btnHamburger"
            android:src="@drawable/linka_app_login_banner" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_alignParentRight="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/newPost"
                android:layout_width="40dip"
                android:layout_height="40dip"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_edit" />

            <ImageButton
                android:id="@+id/btnInbox"
                android:layout_width="40dip"
                android:layout_height="40dip"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:src="@android:drawable/sym_action_chat" />

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="40dip"
                android:layout_height="40dip"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_myplaces" />

        </LinearLayout>
    </RelativeLayout>

    <!-- 2. BARRA DE AÇÕES (BOTÃO + PESQUISA) -->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dip">

        <EditText
            android:id="@+id/editSearch"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginLeft="6dip"
            android:layout_weight="1"
            android:drawableLeft="@android:drawable/ic_menu_search"
            android:drawablePadding="8dip"
            android:hint="Search communities..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true" />
        <Button
            android:id="@+id/btnNewCommunity"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginRight="6dip"
            android:background="#3e48dc"
            android:paddingLeft="14dip"
            android:paddingRight="14dip"
            android:text="+"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. LISTA DE COMUNIDADES -->
    <ListView
        android:id="@+id/listComm"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:cacheColorHint="#00000000"
        android:divider="#CCCCCC"
        android:dividerHeight="1dip"
        android:fadingEdge="none"
        android:fastScrollEnabled="true"
        android:smoothScrollbar="true" />

</LinearLayout>