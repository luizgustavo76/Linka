<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#E5E8EC">

    <!-- FEED EM LISTVIEW IGUAL AO HOME -->
    <ListView
        android:id="@+id/listViewCommunityFeed"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="#E5E8EC"
        android:cacheColorHint="#E5E8EC"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dip"
        android:paddingBottom="76dip"
        android:paddingTop="48dip"
        android:scrollingCache="true" />

    <!-- TOP BAR RETRÁTIL NO MESMO ESTILO DO HOME -->
    <LinearLayout
        android:id="@+id/topHeaderContainer"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/topBarContainer"
            android:layout_width="fill_parent"
            android:layout_height="48dip"
            android:background="@drawable/bg_header_gradient"
            android:paddingLeft="8dip"
            android:paddingRight="8dip">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="34dip"
                android:layout_height="34dip"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_previous" />

            <ImageView
                android:id="@+id/logo"
                android:layout_width="28dip"
                android:layout_height="28dip"
                android:layout_centerVertical="true"
                android:layout_marginLeft="8dip"
                android:layout_toRightOf="@id/btnBack"
                android:scaleType="fitCenter"
                android:src="@drawable/linka_icon_bar" />

            <TextView
                android:id="@+id/txtCommunityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="8dip"
                android:layout_toLeftOf="@+id/rightBarButtons"
                android:layout_toRightOf="@id/logo"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Community"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rightBarButtons"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_alignParentRight="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnRefreshCommunity"
                    android:layout_width="38dip"
                    android:layout_height="38dip"
                    android:background="@android:color/transparent"
                    android:padding="6dip"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_popup_sync" />

                <ImageButton
                    android:id="@+id/btnProfile"
                    android:layout_width="38dip"
                    android:layout_height="38dip"
                    android:layout_marginLeft="6dip"
                    android:background="@android:color/transparent"
                    android:padding="6dip"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_profile" />
            </LinearLayout>
        </RelativeLayout>

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dip"
            android:background="#111111" />
    </LinearLayout>

    <!-- BOTÃO FLUTUANTE DE NOVO POST NA COMUNIDADE -->
    <ImageButton
        android:id="@+id/newPost"
        android:layout_width="56dip"
        android:layout_height="56dip"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="16dip"
        android:layout_marginRight="16dip"
        android:background="@drawable/fab_blue_bg"
        android:padding="14dip"
        android:scaleType="fitCenter"
        android:src="@drawable/icon_post" />

</RelativeLayout>