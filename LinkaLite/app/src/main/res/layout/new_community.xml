<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <!-- 1. CONTEÚDO PRINCIPAL -->
    <LinearLayout 
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="48dip"
            android:background="#1C1C1C"
            android:paddingLeft="8dip"
            android:paddingRight="8dip">

            <ImageButton
                android:id="@+id/btnHamburger"
                android:layout_width="40dip"
                android:layout_height="40dip"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_sort_by_size" />

            <LinearLayout
                android:id="@+id/rightBarButtons"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_alignParentRight="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/newPost"
                    android:layout_width="40dip"
                    android:layout_height="40dip"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_edit" />

                <ImageButton
                    android:id="@+id/btnInbox"
                    android:layout_width="40dip"
                    android:layout_height="40dip"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/sym_action_chat" />

                <ImageButton
                    android:id="@+id/btnProfile"
                    android:layout_width="40dip"
                    android:layout_height="40dip"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_myplaces" />
            </LinearLayout>

            <ImageView
                android:id="@+id/logo"
                android:layout_width="0dip"
                android:layout_height="36dip"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@id/btnHamburger"
                android:layout_toLeftOf="@id/rightBarButtons"
                android:layout_marginLeft="4dip"
                android:layout_marginRight="4dip"
                android:scaleType="fitCenter"
                android:src="@drawable/linka_app_login_banner" />
        </RelativeLayout>

        <!-- Preview do Header da Comunidade -->
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dip">

            <ImageView
                android:id="@+id/imgBanner"
                android:layout_width="fill_parent"
                android:layout_height="90dip"
                android:layout_alignParentTop="true"
                android:scaleType="centerCrop"
                android:background="#DDDDDD" />

            <LinearLayout
                android:id="@+id/panelContent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/imgBanner"
                android:orientation="vertical"
                android:paddingLeft="12dip"
                android:paddingRight="12dip"
                android:paddingTop="28dip">

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="4dip" />

                <TextView
                    android:id="@+id/txtDescription"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="11sp"
                    android:textColor="#333333" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgCommunityAvatar"
                android:layout_width="48dip"
                android:layout_height="48dip"
                android:layout_alignBottom="@id/imgBanner"
                android:layout_alignTop="@id/panelContent"
                android:layout_centerHorizontal="true"
                android:background="#CCCCCC" />
        </RelativeLayout>

        <!-- Formulário e Botões de Ação para Ícone e Banner -->
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dip">

            <!-- Botões Rápidos de Alterar Imagens -->
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dip">

                <Button
                    android:id="@+id/btnEditIcon"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="4dip"
                    android:text="icon"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnEditBanner"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dip"
                    android:text="Banner"
                    android:textSize="12sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/edtName"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="Community Name"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="Community description"
                android:textSize="13sp"
                android:lines="3" />
        </LinearLayout>

    </LinearLayout>

</android.support.v4.widget.DrawerLayout>