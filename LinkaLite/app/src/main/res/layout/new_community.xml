<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:background="?attr/themeBackgroundColor">

    <!-- Top Bar Simples e Leve -->
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="48dip"
        android:background="#1C1C1C"
        android:paddingLeft="12dip"
        android:paddingRight="12dip">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="New Community"
            android:textColor="#262626"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Formulário do Criador -->
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dip">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="#282828"
                android:textSize="12sp"
                android:layout_marginBottom="4dip" />

            <EditText
                android:id="@+id/edtName"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Retro Developers"
                android:textColor="#282828"
                android:textColorHint="#282828"
                android:textSize="14sp"
                android:singleLine="true"
                android:layout_marginBottom="16dip" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginBottom="4dip" />

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="What is this community about?"
                android:textColor="#282828"
                android:textColorHint="#555555"
                android:textSize="14sp"
                android:lines="4"
                android:gravity="top"
                android:layout_marginBottom="24dip" />
            <EditText
                android:id="@+id/edtIconUrl"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="icon url"
                android:textColor="#282828"
                android:textColorHint="#555555"
                android:textSize="14sp"
                android:lines="4"
                android:gravity="top"
                android:layout_marginBottom="24dip" />
            <EditText
                android:id="@+id/edtBannerUrl"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="Banner url"
                android:textColor="#282828"
                android:textColorHint="#555555"
                android:textSize="14sp"
                android:lines="4"
                android:gravity="top"
                android:layout_marginBottom="24dip" />
            <Button
                android:id="@+id/btnCreateCommunity"
                android:layout_width="fill_parent"
                android:layout_height="44dip"
                android:text="Create Community"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>