<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="8dip"
    android:paddingRight="8dip"
    android:paddingTop="6dip"
    android:paddingBottom="6dip"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EEEEEE"
        android:padding="10dip">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dip"
            android:background="#F5F5F5"
            android:padding="8dip">

            <ImageView
                android:id="@+id/postAvatar"
                android:layout_width="36dip"
                android:layout_height="36dip"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_myplaces" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/postAvatar"
                android:layout_centerVertical="true"
                android:layout_marginLeft="8dip"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/postUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/postDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#888888" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/postText"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#222222"
            android:layout_marginBottom="8dip" />

        <!-- CONTAINER DE MÍDIA COM SUPORTE A GIF E CARROSSEL -->
        <RelativeLayout
            android:id="@+id/containerMedia"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dip"
            android:visibility="gone">

            <com.LinkaProject.linkaLite.GifImageView
                android:id="@+id/imgPost"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/txtMediaCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignRight="@id/imgPost"
                android:layout_alignTop="@id/imgPost"
                android:layout_marginRight="6dip"
                android:layout_marginTop="6dip"
                android:background="#88000000"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:paddingLeft="6dip"
                android:paddingRight="6dip"
                android:paddingTop="2dip"
                android:paddingBottom="2dip"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnPrevImage"
                android:layout_width="32dip"
                android:layout_height="32dip"
                android:layout_centerVertical="true"
                android:layout_alignLeft="@id/imgPost"
                android:layout_marginLeft="4dip"
                android:text="◀"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnNextImage"
                android:layout_width="32dip"
                android:layout_height="32dip"
                android:layout_centerVertical="true"
                android:layout_alignRight="@id/imgPost"
                android:layout_marginRight="4dip"
                android:text="▶"
                android:textSize="12sp"
                android:visibility="gone" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnComments"
                android:layout_width="24dip"
                android:layout_height="24dip"
                android:background="@null"
                android:src="@android:drawable/ic_menu_send" />

            <TextView
                android:id="@+id/txtCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dip"
                android:textSize="12sp"
                android:textColor="#666666" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout> 