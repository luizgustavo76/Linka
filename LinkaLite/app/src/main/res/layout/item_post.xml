<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="10dip"
    android:paddingRight="10dip"
    android:paddingBottom="10dip">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_post_card"
        android:clickable="true"
        android:focusable="true">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="12dip"
            android:paddingRight="8dip"
            android:paddingTop="10dip"
            android:paddingBottom="8dip">

            <ImageView
                android:id="@+id/postAvatar"
                android:layout_width="38dip"
                android:layout_height="38dip"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:background="#DDD7CC"
                android:padding="1dip"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_myplaces" />

            <Button
                android:id="@+id/btnPostOptions"
                android:layout_width="28dip"
                android:layout_height="32dip"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_dots_vertical" />

            <TextView
                android:id="@+id/txtSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@id/btnPostOptions"
                android:layout_centerVertical="true"
                android:layout_marginLeft="6dip"
                android:layout_marginRight="4dip"
                android:background="#EAE6DF"
                android:paddingLeft="8dip"
                android:paddingRight="8dip"
                android:paddingTop="3dip"
                android:paddingBottom="3dip"
                android:singleLine="true"
                android:text="+ Slot"
                android:textColor="#2B5B84"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/postAvatar"
                android:layout_toLeftOf="@id/txtSlot"
                android:layout_centerVertical="true"
                android:layout_marginLeft="10dip"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/postUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#1C1917" />
                    <Button
                        android:id="@+id/btnFollow"
                        android:layout_width="30dip"
                        android:layout_height="20dip"
                        android:text="Follow"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#ffff"
                        android:background="@drawable/bg_btn_classic_blue"/>
                    <TextView
                        android:id="@+id/txtPlatform"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text=" &gt; Platform"
                        android:textColor="#2B5B84"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtCommunity"
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text=" &gt; Community"
                        android:textColor="#2B5B84"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/postDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dip"
                    android:textSize="10sp"
                    android:textColor="#8A8277" />
            </LinearLayout>

            <Spinner
                android:id="@+id/optionsSpinner"
                android:layout_width="0dip"
                android:layout_height="0dip"
                android:visibility="gone" />
        </RelativeLayout>

        <TextView
            android:id="@+id/postText"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="12dip"
            android:paddingRight="12dip"
            android:paddingTop="2dip"
            android:autoLink="web"
            android:textColorLink="#2B5B84"
            android:paddingBottom="10dip"
            android:textSize="14sp"
            android:textColor="#26221E"
            android:lineSpacingExtra="2dip" />

        <LinearLayout
            android:id="@+id/containerRepost"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dip"
            android:layout_marginRight="12dip"
            android:layout_marginBottom="10dip"
            android:orientation="vertical"
            android:background="#F7F5F0"
            android:padding="10dip"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/repostAvatar"
                    android:layout_width="24dip"
                    android:layout_height="24dip"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_myplaces" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/repostAvatar"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="8dip"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/repostUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="#1C1917" />

                        <TextView
                            android:id="@+id/repostCommunity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="#2B5B84"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/repostDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="9sp"
                        android:textColor="#8A8277" />
                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/repostText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dip"
                android:autoLink="web"
                android:textColorLink="#2B5B84"
                android:textSize="13sp"
                android:textColor="#3D3833"
                android:lineSpacingExtra="1dip" />

            <com.LinkaProject.linkaLite.GifImageView
                android:id="@+id/repostImg"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dip"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Moldura de Foto Estilo Revelação Instantânea -->
        <FrameLayout
            android:id="@+id/containerMedia"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dip"
            android:layout_marginRight="10dip"
            android:layout_marginBottom="10dip"
            android:background="#1C1917"
            android:visibility="gone">

            <com.LinkaProject.linkaLite.GifImageView
                android:id="@+id/imgPost"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:background="#1C1917" />

            <com.LinkaProject.linkaLite.ProportionalVideoView
                android:id="@+id/videoPost"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnPlayVideo"
                android:layout_width="50dip"
                android:layout_height="50dip"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_play"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtMediaCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|right"
                android:layout_margin="8dip"
                android:background="#99000000"
                android:paddingLeft="6dip"
                android:paddingRight="6dip"
                android:paddingTop="2dip"
                android:paddingBottom="2dip"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnPrevImage"
                android:layout_width="32dip"
                android:layout_height="32dip"
                android:layout_gravity="center_vertical|left"
                android:layout_marginLeft="6dip"
                android:background="#70000000"
                android:text="◀"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnNextImage"
                android:layout_width="32dip"
                android:layout_height="32dip"
                android:layout_gravity="center_vertical|right"
                android:layout_marginRight="6dip"
                android:background="#70000000"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dip"
            android:background="#E8E3DA" />

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="#F7F5F0"
            android:gravity="right|center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dip"
            android:paddingRight="12dip"
            android:paddingTop="7dip"
            android:paddingBottom="7dip">

            <LinearLayout
                android:id="@+id/containerBookmarkOptions"
                android:layout_width="wrap_content"
                android:layout_height="26dip"
                android:layout_marginRight="8dip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#EAE6DF"
                android:paddingLeft="8dip"
                android:paddingRight="6dip"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnPublicBookmarks"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:background="@android:color/transparent"
                    android:text="Public"
                    android:textColor="#2B5B84"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingLeft="4dip"
                    android:paddingRight="4dip" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:textColor="#C8C2B8"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnPrivateBookmarks"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:background="@android:color/transparent"
                    android:text="Private"
                    android:textColor="#666057"
                    android:textSize="11sp"
                    android:paddingLeft="4dip"
                    android:paddingRight="4dip" />

                <ImageButton
                    android:id="@+id/btnCloseBookmarks"
                    android:layout_width="16dip"
                    android:layout_height="16dip"
                    android:layout_marginLeft="6dip"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnComments"
                android:layout_width="22dip"
                android:layout_height="22dip"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_comments" />

            <TextView
                android:id="@+id/txtCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dip"
                android:layout_marginRight="18dip"
                android:textColor="#666057"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="0" />

            <ImageButton
                android:id="@+id/btnReply"
                android:layout_width="22dip"
                android:layout_height="22dip"
                android:layout_marginRight="16dip"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/reply" />

            <ImageButton
                android:id="@+id/btnBookmarks"
                android:layout_width="22dip"
                android:layout_height="22dip"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bookmark" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>