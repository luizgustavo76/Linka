<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_press_selector"
    android:clickable="true"
    android:focusable="true">

    <!-- Cabeçalho do Autor que está Repostando -->
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dip"
        android:paddingRight="12dip"
        android:paddingTop="10dip"
        android:paddingBottom="8dip">

        <ImageView
            android:id="@+id/postAvatar"
            android:layout_width="32dip"
            android:layout_height="32dip"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_myplaces" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/postAvatar"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dip"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/postUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#111111" />

                <TextView
                    android:id="@+id/txtCommunity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:text=" > Community name here"
                    android:textColor="#0b73d3"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/postDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#888888" />

        </LinearLayout>
    </RelativeLayout>

    <!-- Texto do Usuário que Repostou (Comentário por cima do repost, se houver) -->
    <TextView
        android:id="@+id/postText"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dip"
        android:paddingRight="12dip"
        android:paddingBottom="8dip"
        android:textSize="14sp"
        android:textColor="#222222"
        android:lineSpacingExtra="2dip" />

    <!-- Container de Repost Estilo Reddit (Embed do Post Original) -->
    <LinearLayout
        android:id="@+id/containerRepost"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dip"
        android:layout_marginRight="12dip"
        android:layout_marginBottom="8dip"
        android:orientation="vertical"
        android:background="#F4F6F8"
        android:padding="10dip"
        android:visibility="gone">

        <!-- Cabeçalho do Post Original -->
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/repostAvatar"
                android:layout_width="24dip"
                android:layout_height="24dip"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_myplaces" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/repostAvatar"
                android:layout_centerVertical="true"
                android:layout_marginLeft="8dip"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/repostUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#333333" />

                    <TextView
                        android:id="@+id/repostCommunity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#0b73d3"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/repostDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#888888" />

            </LinearLayout>
        </RelativeLayout>

        <!-- Texto do Post Original -->
        <TextView
            android:id="@+id/repostText"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dip"
            android:textSize="13sp"
            android:textColor="#444444"
            android:lineSpacingExtra="1dip" />

        <!-- Mídia do Post Original (se o post repostado tiver imagem/gif) -->
        <com.LinkaProject.linkaLite.GifImageView
            android:id="@+id/repostImg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dip"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Container de Mídia Direta (Caso não seja repost, mas um post normal com imagem) -->
    <RelativeLayout
        android:id="@+id/containerMedia"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <com.LinkaProject.linkaLite.GifImageView
            android:id="@+id/imgPost"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="#F5F5F5" />

        <TextView
            android:id="@+id/txtMediaCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:layout_margin="8dip"
            android:background="#80000000"
            android:paddingLeft="6dip"
            android:paddingRight="6dip"
            android:paddingTop="2dip"
            android:paddingBottom="2dip"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPrevImage"
            android:layout_width="32dip"
            android:layout_height="32dip"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="6dip"
            android:background="#60000000"
            android:text="◀"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNextImage"
            android:layout_width="32dip"
            android:layout_height="32dip"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="6dip"
            android:background="#60000000"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Barra de Ações (Reply, Bookmarks, Comments) -->
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dip"
        android:paddingRight="12dip"
        android:paddingTop="8dip"
        android:paddingBottom="10dip">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/containerBookmarkOptions"
                android:layout_width="wrap_content"
                android:layout_height="26dip"
                android:layout_marginRight="8dip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#F0F0F0"
                android:paddingLeft="8dip"
                android:paddingRight="6dip"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnPublicBookmarks"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:background="@android:color/transparent"
                    android:text="Public"
                    android:textColor="#0066CC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingLeft="4dip"
                    android:paddingRight="4dip" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:textColor="#CCCCCC"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnPrivateBookmarks"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:background="@android:color/transparent"
                    android:text="Private"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:paddingLeft="4dip"
                    android:paddingRight="4dip" />

                <ImageButton
                    android:id="@+id/btnCloseBookmarks"
                    android:layout_width="16dip"
                    android:layout_height="16dip"
                    android:layout_marginLeft="6dip"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnReply"
                android:layout_width="24dip"
                android:layout_height="24dip"
                android:layout_marginRight="16dip"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/reply" />
            <ImageButton
                android:id="@+id/btnComments"
                android:layout_width="24dip"
                android:layout_height="24dip"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_comments" />

            <TextView
                android:id="@+id/txtCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dip"
                android:textColor="#777777"
                android:textSize="11sp"
                android:text="0" />
            <ImageButton
                android:id="@+id/btnBookmarks"
                android:layout_width="24dip"
                android:layout_height="24dip"
                android:layout_marginRight="16dip"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bookmark" />

        </LinearLayout>
    </RelativeLayout>

    <View
        android:layout_width="fill_parent"
        android:layout_height="1dip"
        android:background="#EAEAEA" />

</LinearLayout>