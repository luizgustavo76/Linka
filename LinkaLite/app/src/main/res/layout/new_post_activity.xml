<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dip">

        <LinearLayout
            android:id="@+id/layoutGuest"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFEBEE"
            android:padding="12dip"
            android:layout_marginBottom="12dip"
            android:visibility="gone">

            <TextView
                android:id="@+id/guestText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="You are a guest! Create or login with an account to post."
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#C62828" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dip"
                android:text="Click here to login"
                android:textSize="12sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/themeBackgroundColor"
            android:padding="14dip">

            <TextView
                android:id="@+id/newPostText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="New Post"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/newPostContent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Links are supported now"
                android:textSize="11sp"
                android:textColor="#757575"
                android:layout_marginBottom="12dip" />

            <EditText
                android:id="@+id/editPostContent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:gravity="top|left"
                android:background="#F9F9F9"
                android:padding="8dip"
                android:hint="Whats happening?"
                android:textColor="?attr/themeTextColor"
                android:textColorHint="#AAA"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/containerRepostPreview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:background="#F4F6F8"
                android:orientation="vertical"
                android:padding="10dip"
                android:visibility="gone">
                <ImageView
                        android:id="@+id/avatarRepost"
                        android:layout_width="32dip"
                        android:layout_height="32dip"
                        android:background="#bfbfbf"/>
                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    
                    <TextView
                        android:id="@+id/txtRepostOriginalUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="?attr/themeTextColor"
                        android:textSize="12sp" />

                    <ImageButton
                        android:id="@+id/btnRemoveRepost"
                        android:layout_width="18dip"
                        android:layout_height="18dip"
                        android:layout_alignParentRight="true"
                        android:background="@android:color/transparent"
                        android:src="@android:drawable/ic_menu_close_clear_cancel" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/txtRepostOriginalText"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dip"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="#666666"
                    android:textSize="12sp" />
                <ImageView
                    android:id="@+id/imgMedia"
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:background="#bfbfbf"/>
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/containerMediaPreview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:visibility="gone">

                <com.LinkaProject.linkaLite.GifImageView
                    android:id="@+id/imgMediaPreview"
                    android:layout_width="fill_parent"
                    android:layout_height="180dip"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop" />

                <ImageButton
                    android:id="@+id/btnRemoveMedia"
                    android:layout_width="24dip"
                    android:layout_height="24dip"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="6dip"
                    android:background="#80000000"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </RelativeLayout>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Post in:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#424242"
                android:layout_marginTop="12dip"
                android:layout_marginBottom="6dip" />

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dip">

                <CheckBox
                    android:id="@+id/btnLinka"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Linka"
                    android:textSize="12sp"
                    android:textColor="#212121"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/btnReddit"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reddit"
                    android:textSize="12sp"
                    android:textColor="#212121" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dip">

                <CheckBox
                    android:id="@+id/btnMastodon"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mastodon"
                    android:textSize="12sp"
                    android:textColor="#212121" />

                <CheckBox
                    android:id="@+id/btnBluesky"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bluesky"
                    android:textSize="12sp"
                    android:textColor="#212121" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnImage"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Attach image"
                    android:textSize="12sp"
                    android:layout_marginRight="4dip" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Send!"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginLeft="4dip" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>