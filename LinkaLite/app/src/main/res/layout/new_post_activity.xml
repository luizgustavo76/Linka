<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:background="#E6E6E6">

    <!-- Top Bar Escura estilo Classic Edition -->
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="46dip"
        android:background="@drawable/bg_topbar_classic"
        android:paddingLeft="12dip"
        android:paddingRight="10dip">

        <TextView
            android:id="@+id/newPostText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:text="New Post"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="32dip"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:paddingLeft="14dip"
            android:paddingRight="14dip"
            android:background="@drawable/bg_btn_classic_blue"
            android:text="Send Post"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Linha azul sutil abaixo da barra (assinatura Android 4.0 Holo) -->
    <View
        android:layout_width="fill_parent"
        android:layout_height="2dip"
        android:background="#2B5B84" />

    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="0dip"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dip">

            <!-- Aviso de Guest -->
            <LinearLayout
                android:id="@+id/layoutGuest"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFEBEE"
                android:padding="10dip"
                android:layout_marginBottom="10dip"
                android:visibility="gone">

                <TextView
                    android:id="@+id/guestText"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    :gravity="center"
                    android:text="You are a guest! Create or login with an account to post."
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#C62828" />

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="fill_parent"
                    android:layout_height="36dip"
                    android:layout_marginTop="8dip"
                    android:background="@drawable/bg_btn_classic_blue"
                    android:text="Click here to login"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bloco Unificado: Caixa de Texto + Barra de Anexos acoplada -->
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/editPostContent"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:minLines="5"
                    android:gravity="top|left"
                    android:background="@drawable/bg_composer_top"
                    android:padding="12dip"
                    android:hint="What's happening?"
                    android:textColor="#222222"
                    android:textColorHint="#888888"
                    android:textSize="15sp" />

                <!-- Barra metálica acoplada embaixo -->
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="40dip"
                    android:layout_marginTop="-1dip"
                    android:background="@drawable/bg_composer_bottom"
                    android:gravity="center_vertical"
                    android:paddingLeft="6dip"
                    android:paddingRight="8dip"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnImage"
                        android:layout_width="wrap_content"
                        android:layout_height="30dip"
                        android:layout_marginRight="4dip"
                        android:paddingLeft="8dip"
                        android:paddingRight="8dip"
                        android:background="@drawable/bg_btn_toolbar_classic"
                        android:text="Image"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnVideo"
                        android:layout_width="wrap_content"
                        android:layout_height="30dip"
                        android:layout_marginRight="4dip"
                        android:paddingLeft="8dip"
                        android:paddingRight="8dip"
                        android:background="@drawable/bg_btn_toolbar_classic"
                        android:text="Video"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPoll"
                        android:layout_width="wrap_content"
                        android:layout_height="30dip"
                        android:paddingLeft="8dip"
                        android:paddingRight="8dip"
                        android:background="@drawable/bg_btn_toolbar_classic"
                        android:text="Poll"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/newPostContent"
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:singleLine="true"
                        android:text="Links supported"
                        android:textSize="10sp"
                        android:textColor="#777777" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card de Repost Compacto -->
            <RelativeLayout
                android:id="@+id/containerRepostPreview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:background="@drawable/bg_card_classic"
                android:padding="8dip"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/avatarRepost"
                    android:layout_width="28dip"
                    android:layout_height="28dip"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginRight="8dip"
                    android:background="#BFBFBF" />

                <ImageButton
                    android:id="@+id/btnRemoveRepost"
                    android:layout_width="20dip"
                    android:layout_height="20dip"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentTop="true"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />

                <TextView
                    android:id="@+id/txtRepostOriginalUser"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/avatarRepost"
                    android:layout_toLeftOf="@id/btnRemoveRepost"
                    android:layout_alignTop="@id/avatarRepost"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtRepostOriginalText"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/avatarRepost"
                    android:layout_marginTop="6dip"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="#666666"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/imgMedia"
                    android:layout_width="0dip"
                    android:layout_height="0dip"
                    android:layout_below="@id/txtRepostOriginalText"
                    android:layout_marginTop="4dip"
                    android:background="#BFBFBF" />
            </RelativeLayout>

            <!-- Preview de Mídia Anexada (estilo moldura Insta 2013) -->
            <RelativeLayout
                android:id="@+id/containerMediaPreview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:padding="4dip"
                android:background="@drawable/bg_card_classic"
                android:visibility="gone">

                <com.LinkaProject.linkaLite.GifImageView
                    android:id="@+id/imgMediaPreview"
                    android:layout_width="fill_parent"
                    android:layout_height="190dip"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop" />

                <ImageButton
                    android:id="@+id/btnRemoveMedia"
                    android:layout_width="26dip"
                    android:layout_height="26dip"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="6dip"
                    android:background="#B3000000"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </RelativeLayout>

            <!-- Container de Enquete -->
            <LinearLayout
                android:id="@+id/containerPoll"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dip"
                android:padding="8dip"
                android:orientation="vertical"
                android:background="@drawable/bg_card_classic"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnAddOption"
                    android:layout_width="fill_parent"
                    android:layout_height="34dip"
                    android:layout_marginTop="4dip"
                    android:background="@drawable/bg_btn_toolbar_classic"
                    android:text="+ Add option"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Painel "Share to / Post in" estilo Insta 2013 -->
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dip"
                android:orientation="vertical"
                android:background="@drawable/bg_card_classic">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:background="#F3F3F3"
                    android:paddingLeft="10dip"
                    android:paddingTop="7dip"
                    android:paddingBottom="7dip"
                    android:text="POST IN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#2B5B84" />

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="1dip"
                    android:background="#DCDCDC" />

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dip"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/btnLinka"
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Linka"
                        android:textSize="12sp"
                        android:textColor="#222222"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/btnReddit"
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reddit"
                        android:textSize="12sp"
                        android:textColor="#222222" />
                </LinearLayout>

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="1dip"
                    android:background="#EAEAEA" />

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dip"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/btnMastodon"
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mastodon"
                        android:textSize="12sp"
                        android:textColor="#222222" />

                    <CheckBox
                        android:id="@+id/btnBluesky"
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bluesky"
                        android:textSize="12sp"
                        android:textColor="#222222" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>