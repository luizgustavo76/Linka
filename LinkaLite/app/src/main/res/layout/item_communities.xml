<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dip">

    <!-- 1. BANNER DA COMUNIDADE -->
    <ImageView
        android:id="@+id/imgBanner"
        android:layout_width="fill_parent"
        android:layout_height="90dip"
        android:layout_alignParentTop="true"
        android:scaleType="centerCrop" />

    <!-- 2. CONTEÚDO DA COMUNIDADE -->
    <LinearLayout
        android:id="@+id/panelContent"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgBanner"
        android:orientation="vertical"
        android:paddingLeft="12dip"
        android:paddingRight="12dip"
        android:paddingTop="25dip">

        <!-- Nome da Comunidade -->
        <TextView
            android:id="@+id/txtName"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="4dip" />

        <!-- Descrição da Comunidade -->
        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dip"
            android:textSize="11sp"
            android:textColor="#333333" />

        <!-- Botão 1: Tornar-se Membro -->
        <Button
            android:id="@+id/btnMember"
            android:layout_width="fill_parent"
            android:layout_height="36dip"
            android:layout_marginBottom="4dip"
            android:background="#3e48dc"
            android:text="+ Become a member"
            android:textSize="11sp"
            android:textColor="#ffffff" />

        <!-- Botão 2: Ver Comunidade -->
        <Button
            android:id="@+id/btnView"
            android:layout_width="fill_parent"
            android:layout_height="36dip"
            android:background="#c8c8c8"
            android:text="View community"
            android:textSize="11sp"
            android:textColor="#141414" />
            
    </LinearLayout>

    <!-- 3. AVATAR / LOGO FLUTUANTE -->
    <ImageView
        android:id="@+id/imgCommunityAvatar"
        android:layout_width="48dip"
        android:layout_height="48dip"
        android:layout_alignBottom="@id/imgBanner"
        android:layout_alignTop="@id/panelContent"
        android:layout_centerHorizontal="true" />

</RelativeLayout>