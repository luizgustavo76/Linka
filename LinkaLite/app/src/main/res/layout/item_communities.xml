<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dip"
    android:background="?attr/themeBackgroundColor"
    android:paddingBottom="12dip">

    <!-- 1. BANNER DA COMUNIDADE -->
    <ImageView
        android:id="@+id/imgBanner"
        android:layout_width="fill_parent"
        android:layout_height="90dip"
        android:layout_alignParentTop="true"
        android:scaleType="centerCrop" />

    <!-- 2. CONTEÚDO DA COMUNIDADE -->
    <LinearLayout
        android:id="@+id/panelContent"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgBanner"
        android:orientation="vertical"
        android:paddingLeft="12dip"
        android:paddingRight="12dip"
        android:paddingTop="36dip"> <!-- Dá espaço suficiente para o avatar -->

        <!-- Nome da Comunidade -->
        <TextView
            android:id="@+id/txtName"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextColor"
            android:layout_marginBottom="4dip" />

        <!-- Descrição da Comunidade (Centralizada) -->
        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="12dip"
            android:textSize="12sp"
            android:textColor="#666666" />

        <!-- Botão 1: Tornar-se Membro -->
        <Button
            android:id="@+id/btnMember"
            android:layout_width="fill_parent"
            android:layout_height="36dip"
            android:layout_marginBottom="6dip"
            android:background="#3e48dc"
            android:text="+ Become a member"
            android:textSize="11sp"
            android:textColor="#ffffff" />

        <!-- Botão 2: Ver Comunidade -->
        <Button
            android:id="@+id/btnView"
            android:layout_width="fill_parent"
            android:layout_height="36dip"
            android:background="#dcdcdc"
            android:text="View community"
            android:textSize="11sp"
            android:textColor="#141414" />
            
    </LinearLayout>

    <!-- 3. ÍCONE DA COMUNIDADE (Com borda branca e tamanho 56dip) -->
    <ImageView
        android:id="@+id/imgCommunityAvatar"
        android:layout_width="56dip"
        android:layout_height="56dip"
        android:layout_below="@id/imgBanner"
        android:layout_marginTop="-28dip"
        android:layout_centerHorizontal="true"
        android:background="?attr/themeBackgroundColor"
        android:padding="2dip"
        android:scaleType="centerCrop" />

</RelativeLayout>