<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F6"
    android:orientation="vertical">

    <!-- Header Estilizado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/themeHeaderBg"
        android:padding="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select your theme"
            android:textColor="?attr/themeTextColor"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/btnLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_theme_option"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:text="Light"
                android:textColor="?attr/themeTextColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_theme_option"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:text="Dark"
                android:textColor="?attr/themeTextColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLightBlue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_theme_option"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:text="Light Blue"
                android:textColor="?attr/themeTextColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDarkBlue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_theme_option"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:text="Dark Blue"
                android:textColor="?attr/themeTextColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLightRed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_theme_option"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:text="Light Red"
                android:textColor="?attr/themeTextColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDarkRed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_theme_option"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp"
                android:text="Dark Red"
                android:textColor="?attr/themeTextColor"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>