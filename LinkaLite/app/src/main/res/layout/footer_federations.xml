<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:background="#282c37" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvFooterText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Is your For You feed empty? Customize and edit it in the menu..."
        android:textColor="#888888"
        android:textSize="13sp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnFooterFederations"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personalize it!"
        android:layout_marginTop="8dp"
        android:onClick="personalizeTimeline" />

</LinearLayout>