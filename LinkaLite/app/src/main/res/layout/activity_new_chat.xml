<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_material_card">

    <Button
        android:id="@+id/btnNewGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New group"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_margin="12dp" />

    <Button
        android:id="@+id/btnExternalServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="External Server"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_margin="12dp" />

    <!-- Espaçador flexível para empurrar a barra para o rodapé -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Rodapé DENTRO do container principal -->
    <LinearLayout 
        android:layout_width="match_parent"
        android:layout_height="50dp" 
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#11111b">

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/home"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:contentDescription="home" />

        <ImageButton
            android:id="@+id/btnChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/chat"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:contentDescription="Chat" />

        <ImageButton
            android:id="@+id/btnOptions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/options"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:contentDescription="Options" />

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/account"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:contentDescription="Profile" />

    </LinearLayout>

</LinearLayout>